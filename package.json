{
  "name": "raytab",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm run typecheck && node scripts/icons.mjs && node scripts/notices.mjs && wxt build",
    "postbuild": "node scripts/copy-build.mjs",
    "build:firefox": "pnpm run typecheck && node scripts/icons.mjs && node scripts/notices.mjs && wxt build -b firefox",
    "package": "pnpm run build && wxt zip",
    "postpackage": "node scripts/copy-build.mjs",
    "package:firefox": "pnpm run build:firefox && wxt zip -b firefox",
    "postpackage:firefox": "node scripts/copy-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "i18next": "^26.4.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "6.2.3",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "simple-icons": "^16.32.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "^6.0.0",
    "prettier": "3.9.7",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
