{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src",
    "tests",
    "e2e",
    "wxt.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    ".wxt/wxt.d.ts"
  ]
}
